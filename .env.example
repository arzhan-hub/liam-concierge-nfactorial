DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/liam
APP_URL=http://localhost:3000
# Generate a unique secret before the first owner activation. Local start does this automatically.
SETUP_TOKEN=
# Keep false until approval and launch checks are complete.
LIVE_OPERATIONS=false

# Firebase public web-app identifiers. Copy from the selected Liam Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Enable only after provider configuration and real sign-in tests have passed.
FIREBASE_AUTH_ENABLED=false
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_APPLE_ENABLED=false
# This app verifies public signing keys and uses Firebase's end-user account lookup.
# No Google service-account JSON key is needed by the resident sign-in flow.

# Gmail is a separate OAuth grant from Firebase sign-in. Never expose these as NEXT_PUBLIC.
# Google Auth Platform > Web application > authorized redirect:
# http://localhost:3000/api/mail/callback (or the exact HTTPS APP_URL + /api/mail/callback).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 32 random bytes as 64 hex characters. Keep stable and back up separately from the DB.
MAIL_TOKEN_KEY=

# AI features: server-side only. Choose exactly one tracing backend.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_TRACING_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Alternative when AI_TRACING_PROVIDER=langsmith:
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=liam-concierge-nfactorial

# Explicitly opt in only for a disposable local demonstration database.
DEMO_MODE=false
DEMO_PASSWORD=

# Optional check when importing a downloaded Google OAuth client.
GMAIL_EXPECTED_PROJECT_ID=
