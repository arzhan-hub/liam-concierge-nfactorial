{
  "name": "liam-concierge-nfactorial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node scripts/demo-start.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --env-file-if-exists=.env.local scripts/browser-check.mjs",
    "gmail:setup": "node scripts/configure-gmail.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "rag:index": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/index-policies.ts",
    "eval:golden": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-evals.ts golden",
    "eval:development": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-evals.ts development",
    "eval:ab": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-evals.ts ab",
    "demo:stop": "pg_ctl -D .local/postgres -m fast stop",
    "eval:ocr": "node scripts/eval-label-ocr.mjs"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.17",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^10.9.1",
    "langsmith": "^0.10.5",
    "next": "^16.3.4",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26"
  }
}
